  "author": "liliwen",
  "bugs": {
    "url": "https://github.com/liliwen88/doctor.skill/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "lint": "markdownlint '**/*.md' --ignore node_modules --ignore docs/_site",
    "lint:fix": "markdownlint '**/*.md' --fix --ignore node_modules --ignore docs/_site",
    "format": "prettier --check '**/*.{md,py,json,yaml,yml}'",
    "format:fix": "prettier --write '**/*.{md,py,json,yaml,yml}'",
    "test": "python -m pytest tests/ -v"
  },
