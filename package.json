{
  "name": "family-health-doctor",
  "version": "2.0.0",
  "description": "家庭保健医生 / Family Health Doctor — AI医疗助手 / AI Medical Assistant Skill。支持 SkillsMP 和腾讯 SkillHub 平台的 Agent Skill。分诊评估、症状分析（12种）、预防保健（USPSTF+CDC）、慢性病管理（6种疾病指南）、药物查询（OpenFDA+DailyMed+RxNorm）、检验解读（含儿科）、文献检索、儿科护理、医学术语、健康科普、SOAP临床记录。",
  "keywords": [
    "medical",
    "healthcare",
    "doctor",
    "family-medicine",
    "primary-care",
    "skillsmp",
    "skillhub",
    "agent-skill",
    "medical-ai",
    "symptom-analysis",
    "drug-interaction",
    "pubmed",
    "triage",
    "preventive-care",
    "chronic-disease",
    "pediatric",
    "uspstf",
    "clinical-trials"
  ],
  "homepage": "https://github.com/liliwen88/doctor.skill#readme",
